# DBNet text detection on a 960x960 letterboxed image; output is a probability map.
name: "text_det"
platform: "tensorrt_plan"
max_batch_size: 8

input [
  { name: "image", data_type: TYPE_FP32, dims: [ 3, 960, 960 ] }
]
output [
  { name: "prob", data_type: TYPE_FP32, dims: [ 1, 960, 960 ] }
]

dynamic_batching {
  preferred_batch_size: [ 4, 8 ]
  max_queue_delay_microseconds: 2000
}

instance_group [ { count: 1, kind: KIND_GPU } ]
